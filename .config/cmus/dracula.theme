# Dracula colourscheme for cmus
#
# Uses numeric ANSI colours, which the Dracula xterm palette in
# ~/.Xresources maps to the Dracula palette:
#   0 black  1 red  2 green  3 yellow  4 blue(purple)
#   5 magenta(pink)  6 cyan  7 white
#   8 bright black (comment)  9..15 bright variants
#
# See the LICENSE file at the top of the project tree for copyright
# and license details.

set color_win_fg=7
set color_win_bg=default
set color_win_attr=default
set color_win_dir=12
set color_win_cur=13
set color_win_cur_attr=underline
set color_win_cur_sel_fg=0
set color_win_cur_sel_bg=5
set color_win_cur_sel_attr=default
set color_win_sel_fg=0
set color_win_sel_bg=4
set color_win_sel_attr=default
set color_win_inactive_cur_sel_fg=7
set color_win_inactive_cur_sel_bg=8
set color_win_inactive_cur_sel_attr=default
set color_win_inactive_sel_fg=7
set color_win_inactive_sel_bg=8
set color_win_inactive_sel_attr=default
set color_win_title_fg=13
set color_win_title_bg=default
set color_win_title_attr=bold

set color_statusline_fg=0
set color_statusline_bg=7
set color_statusline_attr=default
set color_titleline_fg=7
set color_titleline_bg=default
set color_titleline_attr=bold
set color_cmdline_fg=7
set color_cmdline_bg=default
set color_cmdline_attr=default
set color_error=1
set color_info=6
set color_separator=8
