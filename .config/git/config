# Dracula colours for git
#
# This file lives in $XDG_CONFIG_HOME/git/config, which git reads
# before ~/.gitconfig: a user's ~/.gitconfig therefore keeps
# precedence and is never overwritten.
#
# See the LICENSE file at the top of the project tree for copyright
# and license details.

[color]
	ui = auto

[color "branch"]
	current = yellow
	local = green
	remote = magenta

[color "status"]
	added = green
	changed = yellow
	untracked = cyan
	branch = magenta

[color "diff"]
	meta = magenta
	frag = cyan
	old = red
	new = green
	commit = yellow
	whitespace = red reverse

[color "decorate"]
	branch = green
	remoteBranch = magenta
	tag = yellow

[color "interactive"]
	prompt = magenta
	header = yellow
	help = cyan
