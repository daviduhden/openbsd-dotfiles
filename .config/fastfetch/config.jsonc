{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "color": {
      "1": "magenta",
      "2": "cyan",
      "3": "green",
      "4": "yellow",
      "5": "blue",
      "6": "red"
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "magenta",
      "output": "white",
      "title": "cyan"
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "shell",
    "terminal",
    "cpu",
    "memory",
    "disk",
    "localip",
    "break",
    "colors"
  ]
}
